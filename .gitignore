# Whitelist: ignore everything, then re-include what is tracked
/*
!/.gitignore
!/README.md
!/LICENSE

# Analysis code
!/scripts/
# Exploratory analyses (not part of the published workflow)
/scripts/single-cell/rmd-exploratory/
/scripts/exploratory/
!/setup/
/setup/refs/
# Cell Ranger containers (rebuilt from Docker Hub by digest, see README; not redistributable)
*.sif

# Reference tables and flow exports (input data in data/ is not tracked); the bowtie2 index is rebuilt by run-hits.sh
!/resources/
/resources/tcr-library/bowtie2_indices/

# renv: lockfile + bootstrap files (library is restored with renv::restore())
!/renv-vhio136/
/renv-vhio136/*
!/renv-vhio136/.Rprofile
!/renv-vhio136/renv.lock
!/renv-vhio136/renv/
/renv-vhio136/renv/*
!/renv-vhio136/renv/activate.R
!/renv-vhio136/renv/settings.json
!/renv-vhio136/renv/.gitignore


.Rhistory
.RData
.Rproj.user/
*.html
